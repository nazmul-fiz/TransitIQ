{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build TransitIQ (CMake Qt6)",
            "command": "cmd",
            "args": [
                "/c",
                "call build.bat"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Configures and compiles TransitIQ using CMake and Qt6"
        },
        {
            "type": "shell",
            "label": "Run Algorithm Test Suite",
            "command": "${workspaceFolder}/test_algorithms.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test",
            "detail": "Runs BFS and DFS automated verification test suite"
        }
    ]
}
